{
    "name": "redis-vl",
    "version": "0.3.1",
    "description": "The AI-native Redis TypeScript/Node.js client for vector operations",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "clean": "rm -rf dist",
        "build": "npm run clean && tsc",
        "build:watch": "tsc --watch",
        "test": "npm run type-check:tests && vitest run",
        "test:unit": "vitest run --config vitest.unit.config.ts",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "test:redis-url": "tsx tests/print-redis-url.ts",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "type-check": "tsc --noEmit",
        "type-check:tests": "tsc --noEmit --project tsconfig.test.json",
        "prepare": "husky",
        "prepublishOnly": "npm run build"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/redis-developer/redis-vl-typescript.git"
    },
    "homepage": "https://redis-developer.github.io/redis-vl-typescript/",
    "bugs": {
        "url": "https://github.com/redis-developer/redis-vl-typescript/issues"
    },
    "keywords": [
        "redis",
        "redis-vl",
        "vector-database",
        "typescript",
        "nodejs",
        "semantic-caching",
        "semantic-routing"
    ],
    "license": "MIT",
    "type": "module",
    "files": [
        "dist",
        "README.md",
        "LICENSE",
        "THIRD_PARTY_NOTICES.md"
    ],
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./stopwords": {
            "types": "./dist/utils/stopwords/index.d.ts",
            "import": "./dist/utils/stopwords/index.js"
        }
    },
    "engines": {
        "node": ">=22.0.0"
    },
    "dependencies": {
        "js-yaml": "^5.5.0",
        "redis": "^6.3.0",
        "zod": "^4.6.7"
    },
    "peerDependencies": {
        "@huggingface/transformers": "^3.0.0"
    },
    "peerDependenciesMeta": {
        "@huggingface/transformers": {
            "optional": true
        }
    },
    "devDependencies": {
        "@huggingface/transformers": "^3.2.1",
        "@types/js-yaml": "^4.0.9",
        "@types/node": "^26.6.5",
        "@typescript-eslint/eslint-plugin": "^8.72.0",
        "@typescript-eslint/parser": "^8.72.0",
        "@vitest/coverage-v8": "^5.0.5",
        "eslint": "^9.39.5",
        "eslint-config-prettier": "^10.1.8",
        "husky": "^9.1.7",
        "lint-staged": "^16.2.7",
        "prettier": "^3.9.10",
        "testcontainers": "^12.2.1",
        "tsx": "^4.23.15",
        "typescript": "^5.9.3",
        "vitest": "^5.0.5"
    },
    "lint-staged": {
        "*.{ts,tsx}": [
            "eslint --fix",
            "prettier --write"
        ],
        "*.{json,md,yaml,yml}": [
            "prettier --write"
        ]
    }
}
